new file mode 100644
index 0000000..1178760
--- /dev/null
+++ b/comfy_kitchen/_torch_compat.py
@@ -0,0 +1,39 @@
+"""Compatibility helpers for PyTorch releases predating ``custom_op``."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any, TypeVar, cast
+
+import torch
+
+_F = TypeVar("_F", bound=Callable[..., Any])
+
+
+def custom_op(qualified_name: str, *, mutates_args: tuple[str, ...]) -> Callable[[_F], _F]:
+    """Use the native custom-op decorator or an eager PyTorch 2.1 fallback.
+
+    PyTorch 2.1 has no ``torch.library.custom_op`` API. Comfy Kitchen's
+    implementations are ordinary Python callables that dispatch through its
+    backend registry, so exposing those callables on ``torch.ops`` preserves
+    eager execution on JetPack 5. Fake registration is intentionally a no-op
+    because the corresponding API is also unavailable on PyTorch 2.1.
+    """
+    native_custom_op = getattr(torch.library, "custom_op", None)
+    if native_custom_op is not None:
+        return cast(Callable[[_F], _F], native_custom_op(qualified_name, mutates_args=mutates_args))
+
+    namespace, separator, op_name = qualified_name.partition("::")
+    if not separator or not namespace or not op_name:
+        raise ValueError(f"Invalid custom-op name: {qualified_name!r}")
+
+    def decorator(function: _F) -> _F:
+        setattr(getattr(torch.ops, namespace), op_name, function)
+
+        def register_fake(fake_function: Callable[..., Any]) -> Callable[..., Any]:
+            return fake_function
+
+        setattr(function, "register_fake", register_fake)
+        return function
+
+    return decorator
