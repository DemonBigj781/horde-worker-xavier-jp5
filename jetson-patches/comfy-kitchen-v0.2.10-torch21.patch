diff --git a/tests/test_torch_21_compat.py b/tests/test_torch_21_compat.py
new file mode 100644
index 0000000..eb6c85f
--- /dev/null
+++ b/tests/test_torch_21_compat.py
@@ -0,0 +1,16 @@
+import torch
+
+import comfy_kitchen as ck
+
+
+def test_legacy_custom_op_fallback_runs_eager_awq() -> None:
+    group_size = 4
+    x = torch.tensor([[1.0, 2.0, 3.0, 4.0]], dtype=torch.float32)
+    qweight = torch.tensor([[0x98, 0xBA]], dtype=torch.uint8).view(torch.int8)
+    wscales = torch.ones((1, 1), dtype=torch.float32)
+    wzeros = torch.zeros((1, 1), dtype=torch.float32)
+
+    result = ck.gemv_awq_w4a16(x, qweight, wscales, wzeros, group_size=group_size)
+
+    assert result.shape == (1, 1)
+    torch.testing.assert_close(result, torch.tensor([[20.0]]))
