diff --git a/tests/test_torch_compat.py b/tests/test_torch_compat.py
new file mode 100644
index 0000000..50f22e0
--- /dev/null
+++ b/tests/test_torch_compat.py
@@ -0,0 +1,67 @@
+"""Tests for the JetPack 5 PyTorch compatibility surface."""
+
+import sys
+from types import SimpleNamespace
+
+from hordelib.utils.torch_compat import install_torch_compat
+
+
+def test_install_torch_compat_adds_legacy_surfaces(monkeypatch) -> None:
+    def dynamo_is_compiling() -> bool:
+        return False
+
+    torch = SimpleNamespace(
+        _dynamo=SimpleNamespace(is_compiling=dynamo_is_compiling),
+        compiler=SimpleNamespace(),
+        library=SimpleNamespace(),
+        nn=SimpleNamespace(RMSNorm=object(), functional=SimpleNamespace(rms_norm=object())),
+        ops=SimpleNamespace(comfy_kitchen=SimpleNamespace()),
+        serialization=SimpleNamespace(),
+    )
+    monkeypatch.setitem(sys.modules, "torch", torch)
+
+    install_torch_compat()
+
+    @torch.library.custom_op("comfy_kitchen::probe", mutates_args=())
+    def probe(value):
+        return value + 1
+
+    @probe.register_fake
+    def probe_fake(value):
+        return value
+
+    assert torch.ops.comfy_kitchen.probe(4) == 5
+    assert probe_fake(4) == 4
+    assert torch.compiler.is_compiling is dynamo_is_compiling
+    assert torch.serialization.add_safe_globals([object]) is None
+
+
+def test_install_torch_compat_preserves_native_surfaces(monkeypatch) -> None:
+    native_is_compiling = object()
+    native_custom_op = object()
+    native_add_safe_globals = object()
+    torch = SimpleNamespace(
+        compiler=SimpleNamespace(is_compiling=native_is_compiling),
+        library=SimpleNamespace(custom_op=native_custom_op),
+        nn=SimpleNamespace(RMSNorm=object(), functional=SimpleNamespace(rms_norm=object())),
+        ops=SimpleNamespace(),
+        serialization=SimpleNamespace(add_safe_globals=native_add_safe_globals),
+    )
+    monkeypatch.setitem(sys.modules, "torch", torch)
+
+    install_torch_compat()
+
+    assert torch.compiler.is_compiling is native_is_compiling
+    assert torch.library.custom_op is native_custom_op
+    assert torch.serialization.add_safe_globals is native_add_safe_globals
+
+
+def test_install_torch_compat_provides_rms_norm() -> None:
+    import torch
+
+    install_torch_compat()
+    layer = torch.nn.RMSNorm(4, eps=1e-6)
+    value = torch.tensor([[1.0, 2.0, 3.0, 4.0]])
+
+    expected = value * torch.rsqrt(value.square().mean(dim=-1, keepdim=True) + 1e-6)
+    assert torch.allclose(layer(value), expected)
diff --git a/tests/test_allocator_environment.py b/tests/test_allocator_environment.py
new file mode 100644
index 0000000..241f41c
--- /dev/null
+++ b/tests/test_allocator_environment.py
@@ -0,0 +1,46 @@
+import os
+
+import pytest
+
+from hordelib import initialisation
+from hordelib.utils.torch_memory import AcceleratorKind
+
+
+@pytest.fixture(autouse=True)
+def clear_allocator_environment(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("PYTORCH_CUDA_ALLOC_CONF", raising=False)
+    monkeypatch.delenv("PYTORCH_HIP_ALLOC_CONF", raising=False)
+
+
+def test_jetson_disables_expandable_segments(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(os.path, "exists", lambda path: path == "/etc/nv_tegra_release")
+
+    initialisation._configure_allocator_environment(AcceleratorKind.cuda)
+
+    assert os.environ["PYTORCH_CUDA_ALLOC_CONF"] == "expandable_segments:False"
+
+
+def test_jetson_preserves_operator_allocator_setting(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(os.path, "exists", lambda path: path == "/etc/nv_tegra_release")
+    monkeypatch.setenv("PYTORCH_CUDA_ALLOC_CONF", "max_split_size_mb:128")
+
+    initialisation._configure_allocator_environment(AcceleratorKind.cuda)
+
+    assert os.environ["PYTORCH_CUDA_ALLOC_CONF"] == "max_split_size_mb:128"
+
+
+def test_non_jetson_cuda_enables_expandable_segments(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(os.path, "exists", lambda _path: False)
+
+    initialisation._configure_allocator_environment(AcceleratorKind.cuda)
+
+    assert os.environ["PYTORCH_CUDA_ALLOC_CONF"] == "expandable_segments:True"
+
+
+def test_rocm_enables_expandable_segments_on_all_platforms(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(os.path, "exists", lambda _path: True)
+
+    initialisation._configure_allocator_environment(AcceleratorKind.rocm)
+
+    assert os.environ["PYTORCH_CUDA_ALLOC_CONF"] == "expandable_segments:True"
+    assert os.environ["PYTORCH_HIP_ALLOC_CONF"] == "expandable_segments:True"
