new file mode 100644
index 0000000..0a13d53
--- /dev/null
+++ b/hordelib/utils/torch_compat.py
@@ -0,0 +1,148 @@
+"""Compatibility helpers for supported legacy PyTorch builds."""
+
+from collections.abc import Callable
+from types import SimpleNamespace
+from typing import Any
+
+
+def install_torch_compat() -> None:
+    """Install the compatibility surface required by the pinned ComfyUI tree."""
+    install_compiler_compat()
+    install_custom_op_compat()
+    install_serialization_compat()
+    install_rms_norm_compat()
+
+
+def install_compiler_compat() -> None:
+    """Backport ``torch.compiler.is_compiling`` using Torch 2.1's Dynamo API."""
+    import torch
+
+    compiler = getattr(torch, "compiler", None)
+    if compiler is None:
+        compiler = SimpleNamespace()
+        torch.compiler = compiler
+    if hasattr(compiler, "is_compiling"):
+        return
+
+    dynamo = getattr(torch, "_dynamo", None)
+    if dynamo is None:
+        import importlib
+
+        dynamo = importlib.import_module("torch._dynamo")
+
+    compiler.is_compiling = dynamo.is_compiling
+
+
+def install_custom_op_compat() -> None:
+    """Provide the small ``torch.library.custom_op`` surface used by Comfy Kitchen.
+
+    JetPack 5's NVIDIA PyTorch 2.1 build predates ``torch.library.custom_op``.
+    Comfy Kitchen 0.2.26 uses custom ops only as dispatch wrappers around its
+    registered eager/CUDA implementations, so direct call-through preserves its
+    runtime behavior while fake/meta registration remains unavailable.
+    """
+    import torch
+
+    if hasattr(torch.library, "custom_op"):
+        return
+
+    def custom_op(qualified_name: str, *, mutates_args: tuple[str, ...] = (), **_: Any) -> Callable:
+        del mutates_args
+        namespace, operation_name = qualified_name.split("::", 1)
+
+        def decorate(function: Callable) -> Callable:
+            def register_fake(fake_function: Callable) -> Callable:
+                return fake_function
+
+            function.register_fake = register_fake  # type: ignore[attr-defined]
+            setattr(getattr(torch.ops, namespace), operation_name, function)
+            return function
+
+        return decorate
+
+    torch.library.custom_op = custom_op  # type: ignore[attr-defined]
+
+
+def install_serialization_compat() -> None:
+    """Backport the safe-global registration API used by modern ComfyUI.
+
+    PyTorch 2.1 loads full pickles by default, so its deserializer does not need
+    the allowlist introduced for newer ``weights_only`` defaults. A no-op keeps
+    ComfyUI import-compatible without changing the legacy deserialization path.
+    """
+    import torch
+
+    if hasattr(torch.serialization, "add_safe_globals"):
+        return
+
+    def add_safe_globals(safe_globals: list[Any]) -> None:
+        del safe_globals
+
+    torch.serialization.add_safe_globals = add_safe_globals  # type: ignore[attr-defined]
+
+
+def install_rms_norm_compat() -> None:
+    """Backport the RMSNorm module and functional API introduced after Torch 2.1."""
+    import torch
+
+    if not hasattr(torch.nn.functional, "rms_norm"):
+
+        def rms_norm(input, normalized_shape, weight=None, eps=None):
+            if isinstance(normalized_shape, int):
+                normalized_shape = (normalized_shape,)
+            else:
+                normalized_shape = tuple(normalized_shape)
+            if eps is None:
+                eps = torch.finfo(input.dtype).eps
+            dimensions = tuple(range(-len(normalized_shape), 0))
+            output = input * torch.rsqrt(input.square().mean(dim=dimensions, keepdim=True) + eps)
+            if weight is not None:
+                output = output * weight
+            return output
+
+        torch.nn.functional.rms_norm = rms_norm  # type: ignore[attr-defined]
+
+    if hasattr(torch.nn, "RMSNorm"):
+        return
+
+    class RMSNorm(torch.nn.Module):
+        __constants__ = ["normalized_shape", "eps", "elementwise_affine"]
+
+        def __init__(
+            self,
+            normalized_shape,
+            eps=None,
+            elementwise_affine=True,
+            device=None,
+            dtype=None,
+        ) -> None:
+            super().__init__()
+            if isinstance(normalized_shape, int):
+                normalized_shape = (normalized_shape,)
+            self.normalized_shape = tuple(normalized_shape)
+            self.eps = eps
+            self.elementwise_affine = elementwise_affine
+            if elementwise_affine:
+                self.weight = torch.nn.Parameter(
+                    torch.empty(self.normalized_shape, device=device, dtype=dtype),
+                )
+            else:
+                self.register_parameter("weight", None)
+            self.reset_parameters()
+
+        def reset_parameters(self) -> None:
+            if self.weight is not None:
+                torch.nn.init.ones_(self.weight)
+
+        def forward(self, input):
+            return torch.nn.functional.rms_norm(
+                input,
+                self.normalized_shape,
+                self.weight,
+                self.eps,
+            )
+
+        def extra_repr(self) -> str:
+            return f"{self.normalized_shape}, eps={self.eps}, elementwise_affine={self.elementwise_affine}"
+
+    torch.nn.RMSNorm = RMSNorm  # type: ignore[attr-defined]
